@{
    // Pick a Bootstrap badge colour based on the payment status.
    string badgeClass;
    switch ((string)ViewBag.status)
    {
        case "AUTHORIZED":         badgeClass = "badge-success";  break;
        case "DECLINED":           badgeClass = "badge-danger";   break;
        case "REVIEW":
        case "PARTIAL_AUTHORIZED": badgeClass = "badge-warning";  break;
        default:                   badgeClass = "badge-secondary"; break;
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <title>Receipt</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.0.0-beta.2/css/bootstrap.min.css" integrity="sha384-PsH8R72JQ3SOdhVi3uxftmaW6Vc51MKb0q5P2rRUpPvrszuE4W1povHYgTpBfshb" crossorigin="anonymous">

    <style>
        /* Matches the decoded-json style on the Token page */
        .decoded-json {
            font-size: 12px;
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 4px;
            padding: 12px;
            white-space: pre-wrap;
            word-break: break-word;
        }
    </style>
</head>

<body>
    <div class="container">
        <div class="card">
            <div class="card-body">
                <h1>Receipt</h1>

                <h4 class="mb-4">
                    Status: <span class="badge @badgeClass">@ViewBag.status</span>
                </h4>

                <h5>Payment Response</h5>
                <p class="text-muted">
                    Full response from the CyberSource Payments API, serialized to JSON.
                    Key fields: <code>id</code> (transaction ID), <code>status</code>,
                    <code>processorInformation</code> (auth code, AVS/CVN results),
                    and <code>orderInformation.amountDetails</code>.
                </p>
                <pre class="decoded-json">@ViewBag.paymentJson</pre>

                <a href="../../" class="btn btn-primary mt-3">Repeat checkout process</a>
            </div>
        </div>
    </div>
</body>
</html>
